# Dependencias
node_modules/
npm-debug.log*
yarn-error.log

# Respaldos de la base: contienen datos reales y hashes de contraseñas.
# NUNCA deben subirse al repositorio.
/respaldos/
*.dump

# Salida generada por `npm run seed:horarios` (CSV por segmento + informe).
# Son datos derivados del .txt de la Facultad: se regeneran cuando haga falta.
/Extras/salida/

# Basura de "Guardar página como" del navegador junto a las mallas (CSS de
# FontAwesome y Google Fonts). El HTML de la malla sí se versiona; esto no.
/Extras/Mallas/*_files/

# Entorno y secretos
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
*.bak

# Archivos temporales del sistema
*.tmp
tmpclaude-*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor y workspace local
.vscode/
.obsidian/
.verb.md
*.swp

# Artefactos del agente de IA (no subir al repo)
.claude/

# Logs
*.log

# Coverage
/coverage/

# Builds locales
/dist/
/build/

# Reportes PDF generados (fase 4)
/reports/*.pdf
